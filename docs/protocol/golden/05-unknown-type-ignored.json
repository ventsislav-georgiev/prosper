{
  "id": "05-unknown-type-ignored",
  "about": "An unknown frame type gets no reply and the connection stays usable.",
  "steps": [
    {
      "send": "fe 00000000"
    },
    {
      "send": "08 00000000"
    },
    {
      "expect": {
        "type": "18",
        "json": {
          "device_id": "string~.+",
          "hostname": "string",
          "ops": [
            "string"
          ],
          "server": "string~prosper|dch",
          "os": "string~.+",
          "name": "string",
          "proto": "string~1\\.[0-9]+",
          "?wakeId": "string"
        }
      }
    }
  ]
}
